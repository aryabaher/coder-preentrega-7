# Proveedor del LLM: google (default), openai o anthropic.
# Para que Phoenix calcule el costo por ejecución, usá openai y gpt-4o-mini.
LLM_PROVIDER=openai

# Solo hace falta la clave del proveedor elegido.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Redis 8 (RedisJSON + RediSearch). RedisSaver.setup() crea los índices.
REDIS_URL=redis://localhost:6379

# Phoenix local. En Docker Compose la API usa http://phoenix:6006/v1/traces.
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# 1: el worker corre dentro de la API. 0: correr aparte con python -m app.worker.
WORKER_IN_API=1

# Si el costo estimado de una ejecución pasa este límite (USD), el grafo pausa para aprobar.
COSTO_MAXIMO_USD=0.01

# Mismo índice que las políticas ya cargadas. Namespace: politicas-internas.
# Embedding: text-embedding-3-small, 1536, cosine.
# Si PINECONE_API_KEY queda vacía, la búsqueda híbrida corre en memoria.
PINECONE_API_KEY=
INDEX_NAME=techcorp-rag-hibrido
